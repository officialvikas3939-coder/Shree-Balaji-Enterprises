# Local development (.env) — copy these from your project's .env file
VITE_SUPABASE_URL="https://<your-project>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<publishable-key>"
VITE_SUPABASE_PROJECT_ID="<project-id>"

# Server-side equivalents (same values, used during SSR / server functions)
SUPABASE_URL="https://<your-project>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<publishable-key>"
SUPABASE_PROJECT_ID="<project-id>"

# No service-role key required: admin panel works through admin-role
# database access rules for the signed-in admin user.
